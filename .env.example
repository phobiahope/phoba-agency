# ============================================
# Переменные окружения для Phoba Agency
# ============================================
#
# На Vercel: Settings → Environment Variables → добавь эти переменные.
# Локально: скопируй этот файл в `.env.local` и подставь значения.
#
# Главное: нужен ZAI_API_KEY. Без него ИИ-ассистент работать не будет.

# ---- LLM-провайдер (ОБЯЗАТЕЛЬНО) ----
# API-ключ для вызова LLM.
# Получить ключ можно у любого OpenAI-совместимого провайдера:
#   • Z.ai (https://z.ai) — по умолчанию, модель GLM-4.6
#   • OpenAI (https://platform.openai.com/api-keys) — модель gpt-4o
#   • OpenRouter (https://openrouter.ai/keys) — мульти-провайдер
#   • DeepSeek (https://platform.deepseek.com/api_keys)
#   • Together AI (https://api.together.xyz/settings/api-keys)
#   • любой другой с OpenAI-совместимым /v1/chat/completions
ZAI_API_KEY=""

# ---- LLM-провайдер (необязательно) ----
# Base URL API с /v1 или /api/v1 в конце.
# По умолчанию: https://api.z.ai/api/v1
# Примеры для других провайдеров:
#   Z.ai (public):  https://api.z.ai/api/v1
#   OpenAI:         https://api.openai.com/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   DeepSeek:       https://api.deepseek.com/v1
#   Together AI:    https://api.together.xyz/v1
# ZAI_BASE_URL="https://api.z.ai/api/v1"

# ---- Модель (необязательно) ----
# Название модели. По умолчанию: glm-4.6
# Примеры:
#   Z.ai:        glm-4.6, glm-4.5
#   OpenAI:      gpt-4o, gpt-4o-mini
#   OpenRouter:  openai/gpt-4o, anthropic/claude-3.5-sonnet
#   DeepSeek:    deepseek-chat
# ZAI_MODEL="glm-4.6"

# ---- Доп. заголовки Z.ai internal API (необязательно) ----
# Используются ТОЛЬКО если у тебя internal API Z.ai (а не обычный публичный ключ).
# Обычным пользователям эти переменные НЕ нужны — оставь их пустыми.
# ZAI_TOKEN=""
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""

# ---- БД Prisma (необязательно для базовой работы) ----
# Локально можно оставить SQLite. На Vercel рекомендуется Vercel Postgres.
DATABASE_URL="file:./db/custom.db"

