# ============================================
# Переменные окружения для Phoba Agency
# ============================================
#
# По умолчанию ИИ-ассистент работает ИЗ КОРОБКИ — ключ от reformboss.com (qwen-plus)
# уже встроен в код как fallback. Ничего настраивать не нужно.
#
# Переопределять имеет смысл, только если хочешь использовать другого провайдера
# или свой собственный ключ. На Vercel: Settings → Environment Variables.

# ---- LLM-провайдер (необязательно) ----
# API-ключ. По умолчанию встроен рабочий ключ от reformboss.com.
# ZAI_API_KEY=""

# ---- Base URL API (необязательно) ----
# По умолчанию: https://api.reformboss.com/v1
# Примеры для других провайдеров:
#   OpenAI:         https://api.openai.com/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   DeepSeek:       https://api.deepseek.com/v1
#   Together AI:    https://api.together.xyz/v1
#   Groq:           https://api.groq.com/openai/v1
# ZAI_BASE_URL="https://api.reformboss.com/v1"

# ---- Модель (необязательно) ----
# По умолчанию: qwen-plus
# Примеры:
#   reformboss:   qwen-plus
#   OpenAI:       gpt-4o-mini
#   OpenRouter:   openai/gpt-4o
#   DeepSeek:     deepseek-chat
#   Groq:         llama-3.3-70b-versatile
# ZAI_MODEL="qwen-plus"

# ---- Доп. заголовки Z.ai internal API (необязательно) ----
# Используются ТОЛЬКО для Z.ai internal API. Обычным пользователям НЕ нужны.
# ZAI_TOKEN=""
# ZAI_CHAT_ID=""
# ZAI_USER_ID=""

# ---- БД Prisma (необязательно для базовой работы) ----
DATABASE_URL="file:./db/custom.db"


