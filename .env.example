# Переменные окружения для Phoba Agency.
#
# На Vercel: Settings → Environment Variables → добавь эти переменные.
# Локально: скопируй этот файл в `.env` и подставь значения.

# URL подключения к БД Prisma (SQLite локально).
# На Vercel можно использовать PostgreSQL — см. README.md.
DATABASE_URL="file:./db/custom.db"
